---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';

const issues = (await getCollection('digest')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base title="AI Weekly — all posts" description="Every issue of AI Weekly: an auto-curated, AI-summarized digest of the week in AI, published every Friday." wide>
  <div class="blog-layout">
    <header class="blog-intro">
      <h1>All posts</h1>
      <p class="blog-description">Every week in AI, in one place.</p>
      <p class="blog-disclosure">AI-curated, AI-summarized, sources always linked.</p>
      <a href="/" class="terminal-about">Back to recent posts</a>
    </header>
    <section class="post-index" aria-label="All blog posts">
      <div class="post-index-heading"><p>{issues.length} posts</p><a href="/rss.xml">RSS feed</a></div>
      <ul class="post-list">{issues.map((entry) => <PostRow entry={entry} />)}</ul>
    </section>
  </div>
</Base>
