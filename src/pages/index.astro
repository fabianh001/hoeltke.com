---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import DigestCard from '../components/DigestCard.astro';
import Terminal from '../components/Terminal';
import StatusDot from '../components/StatusDot.astro';
import SubscribeForm from '../components/SubscribeForm.astro';

const issues = (await getCollection('digest')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const terminalIssues = issues.slice(0, 8).map((entry) => ({
  issue: entry.data.issue,
  title: entry.data.title,
  description: entry.data.description,
  date: entry.data.date.toISOString().slice(0, 10),
  slug: `/digest/${entry.id}/`,
}));

// The newest issue is the page's proof. It renders into the terminal's slot as
// static HTML, so it is readable at first paint, without JS, and to crawlers —
// the island hydrates over this markup instead of painting it.
const newest = issues[0];
const newestMeta = newest && {
  href: `/digest/${newest.id}/`,
  issue: String(newest.data.issue).padStart(2, '0'),
  date: newest.data.date.toISOString().slice(0, 10),
  sources: newest.data.sources.length,
  minutes: Math.max(2, Math.round(newest.body!.split(/\s+/).length / 220)),
};
---

<Base
  title="AI Weekly — a weekly AI digest by Fabian Hoeltke"
  description="A weekly digest of what actually happened in AI — selected, summarized, and published by a pipeline every Friday. Read on the web, by email, or over RSS."
>
  <section class="pt-6 sm:pt-10">
    <h1 class="font-mono text-3xl font-bold tracking-tight text-ink sm:text-4xl">AI Weekly</h1>
    <p class="mt-3 max-w-2xl font-sans text-base leading-relaxed text-muted sm:text-lg">
      A digest of the week in AI, selected and summarized by a pipeline and published every
      Friday. No humans in the loop — every source linked, so you can check the work.
    </p>

    <div class="mt-5 sm:mt-7">
      <Terminal client:load issues={terminalIssues}>
        <p class="hidden text-faint sm:block">▸ ingesting feeds … ok</p>
        <p class="hidden text-faint sm:block">▸ summarizing week … 200</p>
        <p class="sm:mt-2">
          <span class="text-prompt">$</span> <span class="text-ink">cat digest/latest</span>
        </p>

        {
          newestMeta && (
            <article class="mt-2.5 mb-3">
              <p class="text-muted">
                {`issue #${newestMeta.issue} · ${newestMeta.date} · ${newestMeta.sources} sources · ${newestMeta.minutes} min read`}
              </p>
              <h2 class="mt-3 text-xl leading-snug font-semibold tracking-tight text-balance text-ink sm:text-2xl">
                <a href={newestMeta.href} class="hover:text-accent transition-colors">
                  {newest.data.title}
                </a>
              </h2>
              <p class="mt-2 max-w-[68ch] leading-relaxed text-muted">{newest.data.description}</p>
              <p class="mt-2.5">
                <a href={newestMeta.href} class="text-accent hover:underline">
                  read this issue →
                </a>
              </p>
            </article>
          )
        }

        <p class="mt-2">
          <span class="text-prompt">$</span> <span class="text-ink">subscribe</span>
        </p>
        <p class="mt-1 text-muted">one issue every Friday. unsubscribe anytime.</p>
        {/* gstack-shortcut(dec-1a98e3e1): this is the page's conversion point and
            nothing measures it — no baseline, no post-ship signal on subscribes.
            Upgrade when a before/after comparison is needed, or a second landing
            change is proposed. */}
        <div class="mt-2.5 mb-1">
          <SubscribeForm variant="inline" />
        </div>
      </Terminal>
    </div>
  </section>

  <section class="mt-14">
    <div class="flex items-baseline justify-between border-b border-line pb-3 font-mono">
      <h2 class="text-lg font-semibold tracking-wide text-muted uppercase">
        <span class="text-prompt">$</span> ls digest/ --latest
      </h2>
      <a href="/digest" class="text-xs text-faint hover:text-accent transition-colors"
        >all {issues.length} issues →</a
      >
    </div>
    <div class="mt-6 grid gap-4">
      {issues.slice(1, 6).map((entry, i) => <DigestCard entry={entry} index={i} />)}
    </div>
  </section>

  <section class="mt-14 rounded-xl border border-line bg-panel/50 p-6 font-mono text-sm leading-relaxed">
    <div class="flex items-center gap-2 text-xs text-faint">
      <StatusDot />
      <span>pipeline.status</span>
    </div>
    <p class="mt-3 text-muted">
      Next issue ships Friday, 07:00 UTC. The pipeline reads the week's AI news, keeps what
      matters, and validates every cited link before publishing.
      <a href="/about" class="text-accent hover:underline">Who builds this? →</a>
    </p>
  </section>
</Base>
