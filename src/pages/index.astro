---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostRow from '../components/PostRow.astro';
import SubscribeForm from '../components/SubscribeForm.astro';

const issues = (await getCollection('digest')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base
  title="hoeltke.com"
  description="Fabian Hoeltke’s blog. Read AI Weekly: a weekly AI digest, auto-curated and AI-summarized, with every source linked."
  wide
>
  <div class="blog-layout">
    <header class="blog-intro">
      <h1>hoeltke.com</h1>
      <p class="blog-description">A blog about the week in AI.</p>
      <p class="blog-author">By Fabian Hoeltke.</p>
      <p class="blog-disclosure">The week’s top AI stories in a quick read. Catch up in one place, every Friday.</p>
    </header>

    <section class="post-index" aria-label="Recent blog posts">
      <div class="post-index-heading">
        <a href="/rss.xml">RSS feed</a>
      </div>
      <ul class="post-list">
        {issues.slice(0, 10).map((entry, index) => <PostRow entry={entry} featured={index === 0} />)}
      </ul>
      {issues.length === 0 && <p class="index-empty">The first issue is on its way. Subscribe to get it in your inbox.</p>}
      <div class="post-index-footer">
        <a href="/digest/">View all {issues.length} posts <span aria-hidden="true">→</span></a>
      </div>
      <section class="newsletter-section" aria-labelledby="newsletter-heading">
        <div>
          <h2 id="newsletter-heading">The next issue, in your inbox.</h2>
          <p>AI Weekly, every Friday. Unsubscribe anytime.</p>
        </div>
        <SubscribeForm variant="inline" />
      </section>
    </section>
  </div>
</Base>

<style>
  /* Match the reference's soft-focus entrance without moving the reading layout.
     Content is visible by default; only motion-enabled browsers run the reveal. */
  @media (prefers-reduced-motion: no-preference) {
    .blog-intro,
    .post-index-heading,
    .post-list > :global(.post-row),
    .post-index-footer,
    .newsletter-section {
      animation: publication-enter 600ms cubic-bezier(0.22, 1, 0.36, 1) backwards;
    }

    .blog-intro {
      animation-delay: 30ms;
    }

    .post-index-heading {
      animation-delay: 120ms;
    }

    .post-list > :global(.post-row) { animation-delay: 210ms; }
    .post-list > :global(.post-row:nth-child(2)) { animation-delay: 292.5ms; }
    .post-list > :global(.post-row:nth-child(3)) { animation-delay: 375ms; }
    .post-list > :global(.post-row:nth-child(4)) { animation-delay: 457.5ms; }
    .post-list > :global(.post-row:nth-child(5)) { animation-delay: 540ms; }
    .post-list > :global(.post-row:nth-child(6)) { animation-delay: 622.5ms; }
    .post-list > :global(.post-row:nth-child(7)) { animation-delay: 705ms; }
    .post-list > :global(.post-row:nth-child(8)) { animation-delay: 787.5ms; }
    .post-list > :global(.post-row:nth-child(9)) { animation-delay: 870ms; }
    .post-list > :global(.post-row:nth-child(n + 10)) { animation-delay: 952.5ms; }

    .post-index-footer,
    .newsletter-section {
      animation-delay: 975ms;
    }

    /* Keyboard navigation takes precedence over the entrance sequence. */
    .blog-intro:focus-within,
    .post-index-heading:focus-within,
    .post-list > :global(.post-row:focus-within),
    .post-index-footer:focus-within,
    .newsletter-section:focus-within {
      animation: none;
    }
  }

  @keyframes publication-enter {
    from {
      opacity: 0;
      filter: blur(3px);
    }
    to {
      opacity: 1;
      filter: blur(0);
    }
  }
</style>
