---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import DigestCard from '../components/DigestCard.astro';
import Terminal from '../components/Terminal';
import StatusDot from '../components/StatusDot.astro';

const issues = (await getCollection('digest')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const terminalIssues = issues.slice(0, 8).map((entry) => ({
  issue: entry.data.issue,
  title: entry.data.title,
  description: entry.data.description,
  date: entry.data.date.toISOString().slice(0, 10),
  slug: `/digest/${entry.id}/`,
}));
---

<Base
  title="Fabian Hoeltke"
  description="A weekly, auto-generated digest of what actually happened in AI — curated, summarized, and shipped by a pipeline. Built by Fabian Hoeltke."
>
  <section class="pt-6 sm:pt-10">
    <Terminal client:load issues={terminalIssues} />
  </section>

  <section class="mt-14">
    <div class="flex items-baseline justify-between border-b border-line pb-3 font-mono">
      <h2 class="text-sm font-semibold tracking-widest text-muted uppercase">
        <span class="text-prompt">$</span> ls digest/ --latest
      </h2>
      <a href="/digest" class="text-xs text-faint hover:text-accent transition-colors">view all →</a>
    </div>
    <div class="mt-6 grid gap-4">
      {issues.slice(0, 5).map((entry, i) => <DigestCard entry={entry} index={i} />)}
    </div>
  </section>

  <section class="mt-14 rounded-xl border border-line bg-panel/50 p-6 font-mono text-sm leading-relaxed">
    <div class="flex items-center gap-2 text-xs text-faint">
      <StatusDot />
      <span>pipeline.status</span>
    </div>
    <p class="mt-3 text-muted">
      Every Friday at 07:00 UTC, a pipeline reads the week's AI news, asks Claude to keep only what
      matters, and ships a new issue — no humans involved.
      <a href="/about" class="text-accent hover:underline">Who builds this? →</a>
    </p>
  </section>
</Base>
