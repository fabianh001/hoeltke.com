---
import '../styles/global.css';
import StatusDot from '../components/StatusDot.astro';
import SubscribeForm from '../components/SubscribeForm.astro';

interface Props {
  title: string;
  description: string;
  /** absolute path to an OG image, defaults to the site-wide one */
  ogImage?: string;
  noindex?: boolean;
  /** 'article' for digest issues */
  ogType?: 'website' | 'article';
  /** set false on reading pages (articles) to drop the dot grid entirely */
  dotGrid?: boolean;
  wide?: boolean;
}

const {
  title,
  description,
  ogImage = '/og/default.png',
  noindex = false,
  ogType = 'website',
  dotGrid = false,
  wide = false,
} = Astro.props;

const terminalActive = /^\/(terminal|about|travel)(\/|$)/.test(Astro.url.pathname);

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const fullTitle = Astro.url.pathname === '/' ? title : `${title} · hoeltke.com`;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Fabian Hoeltke',
  url: 'https://hoeltke.com',
  jobTitle: 'AI Engineer',
  worksFor: { '@type': 'Organization', name: 'Datadog' },
  sameAs: ['https://github.com/fabianh001', 'https://www.linkedin.com/in/fabian-hoeltke/'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="AI Weekly — hoeltke.com" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="hoeltke.com" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <slot name="head" />
  </head>
  <body class:list={['flex min-h-dvh flex-col font-sans antialiased', !dotGrid && 'no-grid']}>
    <a href="#main-content" class="skip-link">Skip to content</a>
    {dotGrid && <div class="dot-spotlight" aria-hidden="true" />}
    <header class="site-header">
      <a href="/" class="site-brand" aria-label="hoeltke.com home">
        <span aria-hidden="true" class="text-prompt">$</span>
        <span>hoeltke.com</span>
      </a>
      <nav class="site-tabs" aria-label="Main navigation">
        <a href="/" data-shortcut="h" aria-label="Home" aria-keyshortcuts="H" aria-current={!terminalActive ? 'page' : undefined}>
          <span aria-hidden="true" class="tab-key">[H]</span>
          <span aria-hidden="true" class="tab-label">Home</span>
        </a>
        <a href="/terminal/" data-shortcut="t" aria-label="Terminal" aria-keyshortcuts="T" aria-current={terminalActive ? 'page' : undefined}>
          <span aria-hidden="true" class="tab-key">[T]</span>
          <span aria-hidden="true" class="tab-label">Terminal</span>
        </a>
      </nav>
      <button popovertarget="subscribe-pop" class="header-subscribe">Subscribe</button>
    </header>

    <div
      id="subscribe-pop"
      popover
      class="subscribe-popover"
    >
      <SubscribeForm variant="inline" />
    </div>

    <main id="main-content" class:list={['site-main', wide && 'site-main-wide']}>
      <slot />
    </main>

    <footer
      class="site-footer"
    >
      <span class="flex items-center gap-2">
        <StatusDot />
        all systems operational
      </span>
      <span class="flex items-center gap-4">
        <a href="https://github.com/fabianh001" class="hover:text-accent transition-colors">github</a>
        <a href="https://www.linkedin.com/in/fabian-hoeltke/" class="hover:text-accent transition-colors"
          >linkedin</a
        >
        <a href="/rss.xml" class="hover:text-accent transition-colors">rss</a>
        <span>© {new Date().getFullYear()} Fabian Hoeltke</span>
      </span>
    </footer>

    <script>
      import { initSiteNavigation } from '../lib/site-navigation';

      const nav = document.querySelector<HTMLElement>('.site-tabs');
      if (nav) initSiteNavigation(nav);
    </script>

    <script is:inline>
      // cursor-follow dot spotlight
      (() => {
        const spot = document.querySelector('.dot-spotlight');
        if (!spot) return;
        let x = 0;
        let y = 0;
        let raf = 0;
        window.addEventListener(
          'pointermove',
          (e) => {
            x = e.clientX;
            y = e.clientY;
            if (raf) return;
            raf = requestAnimationFrame(() => {
              raf = 0;
              spot.style.setProperty('--mx', x + 'px');
              spot.style.setProperty('--my', y + 'px');
            });
          },
          { passive: true }
        );
      })();
    </script>
  </body>
</html>
