---
import '../styles/global.css';
import StatusDot from '../components/StatusDot.astro';
import SubscribeForm from '../components/SubscribeForm.astro';

interface Props {
  title: string;
  description: string;
  /** absolute path to an OG image, defaults to the site-wide one */
  ogImage?: string;
  noindex?: boolean;
  /** 'article' for digest issues */
  ogType?: 'website' | 'article';
  /** set false on reading pages (articles) to drop the dot grid entirely */
  dotGrid?: boolean;
}

const {
  title,
  description,
  ogImage = '/og/default.png',
  noindex = false,
  ogType = 'website',
  dotGrid = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const fullTitle = Astro.url.pathname === '/' ? title : `${title} · hoeltke.com`;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Fabian Hoeltke',
  url: 'https://hoeltke.com',
  jobTitle: 'AI Engineer',
  worksFor: { '@type': 'Organization', name: 'Datadog' },
  sameAs: ['https://github.com/fabianh001', 'https://www.linkedin.com/in/fabian-hoeltke/'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="AI Weekly — hoeltke.com" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="hoeltke.com" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <slot name="head" />
  </head>
  <body class:list={['font-sans antialiased', !dotGrid && 'no-grid']}>
    {dotGrid && <div class="dot-spotlight" aria-hidden="true" />}
    <header class="mx-auto flex w-full max-w-3xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-5 pt-6 pb-2 font-mono text-sm">
      <a href="/" class="group flex items-center gap-2 text-ink no-underline">
        <span class="text-prompt">$</span>
        <span class="font-semibold tracking-tight group-hover:text-accent transition-colors"
          >hoeltke.com</span
        >
        <span class="hidden text-faint sm:inline">~</span>
      </a>
      <nav class="flex items-center gap-4 text-muted">
        <a href="/digest" class="hover:text-accent transition-colors">digest</a>
        <a href="/about" class="hover:text-accent transition-colors">about</a>
        <a href="/rss.xml" class="hover:text-amber transition-colors" title="RSS feed">rss</a>
        <button
          popovertarget="subscribe-pop"
          class="rounded-md border border-green px-3 py-1 text-green hover:bg-green/10 transition-colors"
        >
          subscribe
        </button>
      </nav>
    </header>

    <div
      id="subscribe-pop"
      popover
      class="m-0 ml-auto mt-2 mr-5 w-[min(92vw,340px)] rounded-xl border border-line bg-panel p-5 text-ink shadow-xl"
    >
      <SubscribeForm variant="inline" />
    </div>

    <main class="mx-auto w-full max-w-3xl px-5 pb-20">
      <slot />
    </main>

    <footer
      class="mx-auto flex w-full max-w-3xl flex-wrap items-center justify-between gap-3 border-t border-line px-5 py-6 font-mono text-xs text-muted"
    >
      <span class="flex items-center gap-2">
        <StatusDot />
        all systems operational
      </span>
      <span class="flex items-center gap-4">
        <a href="https://github.com/fabianh001" class="hover:text-accent transition-colors">github</a>
        <a href="https://www.linkedin.com/in/fabian-hoeltke/" class="hover:text-accent transition-colors"
          >linkedin</a
        >
        <span class="text-faint">© {new Date().getFullYear()} Fabian Hoeltke</span>
      </span>
    </footer>

    <script is:inline>
      // cursor-follow dot spotlight
      (() => {
        const spot = document.querySelector('.dot-spotlight');
        if (!spot) return;
        let x = 0;
        let y = 0;
        let raf = 0;
        window.addEventListener(
          'pointermove',
          (e) => {
            x = e.clientX;
            y = e.clientY;
            if (raf) return;
            raf = requestAnimationFrame(() => {
              raf = 0;
              spot.style.setProperty('--mx', x + 'px');
              spot.style.setProperty('--my', y + 'px');
            });
          },
          { passive: true }
        );
      })();
    </script>
  </body>
</html>
