---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'digest'>;
  featured?: boolean;
}

const { entry, featured = false } = Astro.props;
const { title, description, date } = entry.data;
const dateLabel = date.toLocaleDateString('en-US', {
  month: 'short', day: '2-digit', year: 'numeric', timeZone: 'UTC',
});
const minutes = Math.max(2, Math.round((entry.body ?? '').split(/\s+/).length / 220));
---

<li class:list={['post-row', featured && 'post-row-featured']}>
  <a href={`/digest/${entry.id}/`}>
    <div class="post-date">
      <time datetime={date.toISOString()}>{dateLabel}</time>
    </div>
    <div class="post-copy">
      <h2>{title}</h2>
      {featured && <p class="post-description">{description}</p>}
    </div>
    <span class="post-time">{minutes} <span class="sr-only">minutes to read</span><span aria-hidden="true">min</span></span>
  </a>
</li>
