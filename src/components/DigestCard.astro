---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'digest'>;
  /** stagger index for the entrance animation */
  index?: number;
}

const { entry, index = 0 } = Astro.props;
const { title, description, date, issue, tags } = entry.data;
const dateStr = date.toISOString().slice(0, 10);
const readMinutes = Math.max(2, Math.round(entry.body!.split(/\s+/).length / 220));
// issue hairlines cycle green → purple → blue
const edge = ['var(--green)', 'var(--accent-vivid)', 'var(--blue)'][index % 3];
---

<a
  href={`/digest/${entry.id}/`}
  class="rise group block rounded-xl border border-line bg-panel/70 p-5 no-underline backdrop-blur-sm transition-all duration-300 hover:-translate-y-0.5 hover:border-line-bright hover:shadow-[0_0_24px_var(--glow)]"
  style={`animation-delay: ${index * 70}ms; border-top-color: ${edge}`}
>
  <div class="flex items-baseline justify-between gap-4 font-mono text-xs text-faint">
    <span class="text-prompt">issue #{String(issue).padStart(2, '0')}</span>
    <span>{dateStr} · {readMinutes} min</span>
  </div>
  <h3 class="mt-2 font-mono text-lg font-semibold tracking-tight text-ink group-hover:text-accent transition-colors">
    {title}
  </h3>
  <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-muted">{description}</p>
  {
    tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5 font-mono text-[11px]">
        {tags.map((tag) => (
          <span class="rounded border border-line px-1.5 py-0.5 text-faint">{tag}</span>
        ))}
      </div>
    )
  }
</a>
