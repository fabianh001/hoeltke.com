---
interface Props {
  title: string;
  url: URL | string;
}
const { title, url } = Astro.props;
const u = encodeURIComponent(url.toString());
const t = encodeURIComponent(title);
---

<div class="flex flex-wrap items-center gap-3 font-mono text-xs text-muted">
  <span class="text-faint">share:</span>
  <a href={`https://x.com/intent/post?text=${t}&url=${u}`} class="hover:text-accent transition-colors">x</a>
  <a
    href={`https://www.linkedin.com/sharing/share-offsite/?url=${u}`}
    class="hover:text-accent transition-colors">linkedin</a
  >
  <a href={`https://news.ycombinator.com/submitlink?u=${u}&t=${t}`} class="hover:text-amber transition-colors"
    >hn</a
  >
  <button
    data-share-url={url.toString()}
    class="copy-link cursor-pointer hover:text-green transition-colors">copy-link</button
  >
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-link').forEach((btn) => {
    btn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(btn.dataset.shareUrl!);
      const original = btn.textContent;
      btn.textContent = 'copied ✓';
      setTimeout(() => (btn.textContent = original), 1500);
    });
  });
</script>
