# OpenRouter — used for AI digest summarization and TTS generation
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
# optional: override TTS model (default: google/gemini-3.1-flash-tts-preview)
TTS_MODEL=google/gemini-3.1-flash-tts-preview
# optional: override TTS voice (default: Orus)
TTS_VOICE=Orus
# optional: override TTS bitrate (default: 64k for speech-optimized small file size)
TTS_BITRATE=64k

# Resend — used by `npm run send-newsletter` (locally / in CI).
# The subscribe service on the server has its own env file (/etc/subscribe.env).
RESEND_API_KEY=re_xxxxxxxx
RESEND_SEGMENT_ID=00000000-0000-0000-0000-000000000000
# optional: where newsletter replies land (unset → the from address)
RESEND_REPLY_TO=you@example.com
